# New Café & Franchisee Journey — environment variables
# Copy to .env for local dev. On Railway, set these in the service Variables tab.

# Postgres connection string. On Railway this is auto-provided by the attached
# Postgres service as DATABASE_URL — do NOT set it manually there.
DATABASE_URL=postgres://user:password@localhost:5432/new_cafe_journey

# HTTP port. Railway sets PORT automatically — do NOT set it manually there.
PORT=8080

NODE_ENV=development

# --- Parked until near-launch (not yet wired in) ---
# Auth (internal HQ staff login + scoped franchisee access)
# JWT_SECRET=

# S3-compatible file storage for proof-of-completion uploads (Cloudflare R2 / AWS S3)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=

# Transactional email for overdue notifications (Resend / SendGrid, undecided)
# EMAIL_API_KEY=
# EMAIL_FROM=

# Beeline (B.Better) live completion pull
# BEELINE_API_BASE=
# BEELINE_API_KEY=
